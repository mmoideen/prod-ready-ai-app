# Auth.js (next-auth) secret used to sign and encrypt session tokens.
# Generate a real value with: openssl rand -base64 32
AUTH_SECRET=

# Microsoft Entra ID (Azure AD) app registration application (client) ID.
AUTH_MICROSOFT_ENTRA_ID_ID=

# Microsoft Entra ID app registration client secret value.
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# Microsoft Entra ID issuer URL. Format: https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Set to true to enable the "Local development" sign in path. Only ever honored
# when NODE_ENV is not "production", regardless of this value.
AUTH_LOCAL_DEV=

# Role assigned to the local development fake user: viewer, editor, or admin. Defaults to admin when empty.
AUTH_LOCAL_DEV_ROLE=

# Comma separated email addresses granted the admin role when no role claim is present.
RBAC_ADMIN_EMAILS=

# Comma separated email addresses granted the editor role when no role claim is present.
RBAC_EDITOR_EMAILS=

# Azure OpenAI resource endpoint. Format: https://<resource-name>.openai.azure.com
# Leave empty to use the offline mock AI client instead of a real model.
AZURE_OPENAI_ENDPOINT=

# Azure OpenAI API key. Leave empty to use the offline mock AI client.
AZURE_OPENAI_API_KEY=

# Azure OpenAI deployment name to call for the summarize function. Defaults to gpt-4o-mini when empty.
AZURE_OPENAI_DEPLOYMENT=

# Azure OpenAI REST API version. Defaults to a recent stable version when empty.
AZURE_OPENAI_API_VERSION=

# Application Insights connection string. When set, telemetry exports to Azure
# Monitor instead of the console.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Service name attached to emitted telemetry spans. Defaults to internal-tool-template when empty.
OTEL_SERVICE_NAME=
