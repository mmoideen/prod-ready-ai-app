# Minimal AI Tool - environment configuration
# Copy this file to .env for local development. Never commit a real .env
# file (only .env.example is tracked). Every value below is empty or an
# obvious placeholder; see README.md's configuration table for defaults
# and real-world guidance.

# Port the HTTP server listens on. Empty uses the built-in default (3001).
PORT=

# Runtime environment name. Empty uses the built-in default (development).
NODE_ENV=

# Comma separated "token:role" pairs consumed by the bearer-token auth
# middleware (src/auth.ts) and checked against the RBAC policy in
# src/rbac.ts. Roles are "viewer" or "admin". These example pairs are
# obviously fake and safe to commit; in a real deployment tokens are
# issued and rotated from a vault (for example Azure Key Vault, see
# infra/bicep/main.bicep), never hardcoded in a plain environment
# variable.
API_TOKENS=tok-viewer-fake:viewer,tok-admin-fake:admin

# Azure OpenAI settings (src/ai/azure-openai.ts). When ALL FOUR of the
# AZURE_OPENAI_* values below are set, src/ai/index.ts selects the Azure
# OpenAI provider instead of the deterministic mock provider
# (src/ai/mock.ts). Leave these unset for local development, tests, and
# evals: the mock provider is the default and requires no network access
# or API key.
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=changeme-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name
AZURE_OPENAI_API_VERSION=
